{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/wec-coder:9b-16k",
  "instructions": [
    "AGENTS.md",
    "PROJECT_STATE.md",
    "ARCHITECTURE.md",
    "MODULE_MAP.md",
    "SCIENCE_RULES.md"
  ],
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 4096
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".venv/**",
      "**/__pycache__/**",
      ".pytest_cache/**",
      "data/**",
      "outputs/**",
      "results/**"
    ]
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local — zero cost)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "wec-coder:9b-16k": {
          "name": "WEC Coder — Qwen3.5 9B Q4_K_M (16 K context, temp 0.2)",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen2.5 Coder 7B — lightweight fallback for trivial edits",
          "limit": {
            "context": 8192,
            "output": 2048
          }
        }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter (cloud fallback — requires OPENROUTER_API_KEY in shell)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "${OPENROUTER_API_KEY}"
      },
      "models": {
        "qwen/qwen3-235b-a22b:free": {
          "name": "Qwen3 235B A22B (free tier — strong reasoning, architecture questions)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "deepseek/deepseek-r1:free": {
          "name": "DeepSeek R1 (free tier — best for hard maths/physics derivations)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "google/gemma-3-27b-it:free": {
          "name": "Gemma 3 27B (free tier — fast, good for code review)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "*/.env": "deny",
      "*/.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "credentials.json": "deny",
      "*/credentials.json": "deny",
      "token.json": "deny",
      "*/token.json": "deny",
      ".git/*": "deny"
    },
    "edit": {
      "*": "ask",
      ".env": "deny",
      ".env.*": "deny",
      "*/.env": "deny",
      "*/.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "credentials.json": "deny",
      "*/credentials.json": "deny",
      "token.json": "deny",
      "*/token.json": "deny",
      "data/*": "deny"
    },
    "external_directory": "deny",
    "webfetch": "ask",
    "websearch": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls*": "allow",
      "find *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      ".venv/bin/python -m pytest *": "allow",
      ".venv/bin/pytest *": "allow",
      "python -m pytest *": "allow",
      "MPLCONFIGDIR=* .venv/bin/python -m pytest *": "allow",
      "rm *": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git push*": "deny",
      "git checkout --*": "deny",
      "git restore *": "deny"
    }
  }
}
